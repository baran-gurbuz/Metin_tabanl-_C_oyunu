		{"id":"4fbd9650e64f82d5","type":"group","x":1508,"y":-727,"width":776,"height":290,"label":"c1"},
		{"id":"309c4614e9c197fc","type":"group","x":1880,"y":-1051,"width":655,"height":331,"label":"c2"},
		{"id":"0038883201a027fe","type":"group","x":1053,"y":-1390,"width":721,"height":262,"label":"c3"},
		{"id":"89bd3f3e1d7ed9f9","type":"group","x":2003,"y":-2460,"width":629,"height":284,"label":"c15"},
		{"id":"d6cc4cb44122db3b","type":"text","text":"1. yolu seçer ve yürümeye devam eder","x":966,"y":-324,"width":250,"height":60},
		{"id":"0f7a378d0f0450e2","type":"text","text":"2. yolu seçer ve yürümeye devam eder","x":1549,"y":-328,"width":250,"height":60},
		{"id":"7f8923ec306b2c72","type":"text","text":"yol bir bataklığa çıkmıştır. 2 se.eneği vardır","x":1749,"y":-517,"width":250,"height":60},
		{"id":"f444e0ff1c829390","type":"text","text":"1- bataklığın içinden geçmeye karar verir","x":1528,"y":-698,"width":250,"height":60},
		{"id":"8ad210ce31f9aa28","type":"text","text":"bataklık çok derin değildir ve kolayca ilerlerken bir anda ayağını bişey tutar.\nbataklığın altına çekilmeye başlar.","x":1340,"y":-900,"width":250,"height":160},
		{"id":"cd5e51c46b01bf68","type":"text","text":"tam öldüğünü düşünürken bataklığın altında farklı bir dünya olduğunu fark eder.","x":1558,"y":-1037,"width":250,"height":97},
		{"id":"2b2525c24d3a007b","type":"text","text":"yeşil ve çirkin bir yaratıkla karşı karşıyadır.","x":1312,"y":-1208,"width":250,"height":60},
		{"id":"b434db44438f0349","type":"text","text":"1- kaçmaya çalışır ve arkasını dönüp koşar.","x":1073,"y":-1360,"width":250,"height":60},
		{"id":"9271dbed7303eb34","type":"text","text":"2- yaratıkla konuşmaya çalışır ama cevap alamaz","x":1504,"y":-1370,"width":250,"height":60},
		{"id":"eee78101aa041a60","type":"text","text":"yaratık onu takip etmesini ister gibi hareketler yapıp yürümeye başlar.","x":1673,"y":-1568,"width":250,"height":108},
		{"id":"254e4478cd169bc1","type":"text","text":"yol gittikçe yükselir ve bir uçurumun kenarına gelir","x":772,"y":-494,"width":250,"height":60},
		{"id":"c533abcfe34ef786","type":"text","text":"2-bataklığın etrafından dolanmaya karar verir","x":2014,"y":-707,"width":250,"height":60},
		{"id":"583e78dfb89cb38c","type":"text","text":"bataklıktan garip sesler geldiğini fark eder. orman gittikçe sıkılaşmaya devam eder. azimle devam eder ve sonunda bir yola çıkar. ","x":2016,"y":-900,"width":250,"height":160},
		{"id":"78c93d5c4a99b241","type":"text","text":"1- yolu sola doğru takip eder","x":1900,"y":-1027,"width":250,"height":60},
		{"id":"8445daad1d0a8cb0","type":"text","text":"bir araba yaklaşıyordur ve kullanıcı aracı durdurur.","x":1855,"y":-1242,"width":250,"height":60},
		{"id":"a3a01c5bbae2565b","type":"text","text":"aracı yaşlı bir kadın sürüyordur. oyuncu derdini anlatır ve kadın onu arabasına alır. şehre gittiğini söyler","x":1970,"y":-1500,"width":250,"height":160},
		{"id":"05e4d5e6383ff068","type":"text","text":"yolda giderlerken oyuncu hafızasından bazı anılar görür. anıya göre ormanda onu kovalayan ve kafasına vurup bayıltan kişi bu kadındır. ","x":2210,"y":-1738,"width":250,"height":198},
		{"id":"6de5ee1e4da57a54","type":"text","text":"2- yolu sağa  doğru takip eder","x":2265,"y":-1031,"width":250,"height":60},
		{"id":"a044c88db51baeee","type":"text","text":"yaratığın bir mağaraya girdiğini gören oyuncunun 2 seçeneği vardır","x":1852,"y":-1738,"width":250,"height":98},
		{"id":"370c8eba2e9c57fb","type":"text","text":"1- yaratıkla içeri geçer","x":1613,"y":-1917,"width":250,"height":60},
		{"id":"3c05fc7b2d2228f2","type":"text","text":"oyuncu ile sohpete başlar\n\"benim adım allen ve ben bir çift canlıyım\"","x":1380,"y":-2299,"width":250,"height":99},
		{"id":"e5a40e9d0cdfd355","type":"text","text":"1- çift canlıda nedir","x":1161,"y":-2480,"width":250,"height":60},
		{"id":"dd5ca37d5d591f30","type":"text","text":"2- benim eve dönmem lazım, yardım et","x":1595,"y":-2488,"width":250,"height":60},
		{"id":"957a52d226775d71","type":"text","text":"\"çift canlı, 2 farklı türüde aynı yaşamda deneyimleyenlere denir. ve artık sende bir çift canlı olacaksın. benimle birlikte bu diyarda yaşayabilirsin. savaşların olmadığı, bolluğun olduğu bir dünya. tek şart günde 2 saat boyunca bataklık canavarı olarak bataklığa düşenleri bu tarafa çekmen bekleniyor.\"","x":875,"y":-2740,"width":250,"height":338},
		{"id":"fd1ac152a3534cc4","type":"text","text":"3- bana zarar verecekmisin.","x":1374,"y":-2605,"width":250,"height":60},
		{"id":"75b31509f1bf0eec","type":"text","text":"\"dostum malesef artık eve dönemessin. yani buraya alışsan iyi olur. ama merak etme, burası geldiğin yerden daha iyi bir yer\"","x":1700,"y":-2740,"width":250,"height":165},
		{"id":"a5b74073d807e5f0","type":"text","text":"\"hayır tabiki de. artık seninle en yakın arkadaşlar olarak bu güzel dünyada yaşayacağız, ne dersin?\"","x":1374,"y":-2897,"width":250,"height":157},
		{"id":"91a74f3c80b0175a","type":"text","text":"1- \"bu delilik. ben geri dönüyorum\" der ve evden dışarı çıkar.","x":654,"y":-2897,"width":250,"height":79},
		{"id":"dfa1147908e98ae9","type":"text","text":"2- \" bu kadar kötülüğün olduğu bir dünyada yaşayacağıma buada kalırım daha iyi.\"","x":1012,"y":-2960,"width":250,"height":114},
		{"id":"017dd808589a0742","type":"text","text":"1- vaadiye doğru gider","x":398,"y":-3276,"width":250,"height":60},
		{"id":"03385c9b635fa6c6","type":"text","text":"2- ormana doğru gider","x":791,"y":-3292,"width":250,"height":60},
		{"id":"344fb7746691833d","type":"text","text":"1- oyuncu sakince allen la beklemeye başlar","x":1213,"y":-3110,"width":250,"height":60},
		{"id":"b799cb58b2ea0adc","type":"text","text":"allen akşam yemeği hazırlar ve oyuncuya ikram eder. masa leziz görünüyordur.","x":1211,"y":-3290,"width":250,"height":60},
		{"id":"6fa235754479fab7","type":"text","text":"geldiği bataklığa tekrardan girmeye çalışır. başarır ama bu seferde hareket edemez. yavaşça nefesi biter ve ölür.","x":793,"y":-3542,"width":250,"height":123},
		{"id":"2fdbb0379a1e187d","type":"text","text":"1- oyuncu açlığa dayanamaz ve yemeye gömülür ","x":1013,"y":-3622,"width":250,"height":80},
		{"id":"c5f95aa6663e54e7","type":"text","text":"2- aslandan kaçar","x":555,"y":-3652,"width":250,"height":60},
		{"id":"ba1e1bb92a7e59a5","type":"text","text":"1- aslanla iletişim kurmaya çalışır","x":148,"y":-3645,"width":250,"height":60},
		{"id":"028977ac7e41655d","type":"text","text":"korkuyla kapıyı açar ve tam o sırada karşısında bir insan görür. bu kişiye derdini anlatır.","x":549,"y":-3853,"width":250,"height":133},
		{"id":"d6124beec5507a53","type":"text","text":"aslan gerçek bir aslandır ve oyuncu aslana yem olur","x":148,"y":-3819,"width":250,"height":60},
		{"id":"153c554452566366","type":"text","text":"üzüm bağları arasından geçer. burası cennet gibidir. ileride bir ev görür. evin içine girmeye karar verir. karşısında yerde uzanan bir aslan vardır.","x":340,"y":-3539,"width":250,"height":180},
		{"id":"9f4c9461e5a47f6f","type":"text","text":"oyuncu dışarı çıkar ve etrafa bakınır. adeta şiir kitabından çıkmış bir vadi görür karşısında. kafasını geldiği yere çevirir ve bir orman görür. ","x":625,"y":-3200,"width":250,"height":170},
		{"id":"10d8ec977e384350","type":"text","text":"adam onu anladığını ve istiyorsa onu geri gönderebileceğini söyler. ama sorar: \"gerçekten bu kadar kötülüğün olduğu bir dünyaya dönmek istiyorumusun\"","x":554,"y":-4065,"width":250,"height":182},
		{"id":"0d9b39d1fd5ae95f","type":"text","text":"1- adam geri dönmeyi seçer ve yatağında uyanır. 1939 yılında polonyada yaşayan bir yahudidir.","x":338,"y":-4240,"width":278,"height":102},
		{"id":"d466228fa15de736","type":"text","text":"2- yaratık içeri geçer ama oyuncu dışarıda kalıp etrafı incelemeye başlar.","x":2074,"y":-1960,"width":250,"height":109},
		{"id":"fd16de249c0f829d","type":"text","text":"kadın bunun üzerine aracı durdurur.","x":2170,"y":-2256,"width":250,"height":60},
		{"id":"6deb5a2cec956737","type":"text","text":"1- araçtan atlar","x":2230,"y":-2081,"width":250,"height":60},
		{"id":"72faee02aede83fa","type":"text","text":"1- ormana girer","x":2023,"y":-2433,"width":250,"height":60},
		{"id":"6bbe98f9207de350","type":"text","text":"içerisi çok güzel dizayn edilmiş modern bir evdir. yaratık bir anda normal bir insana dönüşür.","x":1363,"y":-2140,"width":250,"height":112},
		{"id":"680aad1a228bc5d9","type":"text","text":"2- çaktırmaz ve devam eder","x":2590,"y":-2088,"width":250,"height":60},
		{"id":"10c419de42893c13","type":"text","text":"kadın onunla iletişim kurdukça oyuncu işkillenmeye başlar","x":2722,"y":-2380,"width":250,"height":101},
		{"id":"a2a5181c221eb6bf","type":"text","text":"2- yolun diğer tarafına doğru kaçmaya başlar","x":2362,"y":-2440,"width":250,"height":60},
		{"id":"ed6aeabef83a9321","type":"text","text":"kadın araçtan inip oyuncuya seslenir. tam o sırada bir araç daha gelir. oyuncu derdini ona anlatır ve adam oyuncuyu arabasına alır. yola devam ederler. ","x":2352,"y":-2700,"width":250,"height":212},
		{"id":"7fdfe7ce00249c19","type":"text","text":"2- kadınla yolculuğa devam eder.","x":2772,"y":-2606,"width":250,"height":60},
		{"id":"07c0203ae32c6868","type":"text","text":"ormanın derinliklerine doğru ilerler ve kaybolur. ","x":2031,"y":-2613,"width":250,"height":60},
		{"id":"2a3a07d3c9fb596a","type":"text","text":"diğer kadında arabasına biner ve birbirlerini görebilecek şekilde şehre doğru hareket ederler. ","x":2293,"y":-2897,"width":250,"height":137},
		{"id":"603523cc2fbebb73","type":"text","text":"şehre varırlar. doktor oyuncuyu kontrol eder. hafızası yanılıyorur ve bu normaldir.","x":2913,"y":-2960,"width":250,"height":162},
		{"id":"d49be988704bb62c","type":"text","text":"1- oyuncu allen la yaşamaya karar verir ve hatanını sonuna kadar bir bataklık canavarı olur","x":1817,"y":-3000,"width":250,"height":148},
		{"id":"9e8e798a116780ff","type":"text","text":"oyuncunun hafızası tekrardan canlanır ve bu kez aklında ona vuran kişi bu adamdır","x":2237,"y":-3140,"width":250,"height":126},
		{"id":"a854bfffcbb15edb","type":"text","text":"1- arabadan atla","x":2052,"y":-3302,"width":250,"height":60},
		{"id":"c3e592825a107b3d","type":"text","text":"3- çaktırma","x":2457,"y":-3308,"width":250,"height":60},
		{"id":"6bf8a7ddc85a6a20","type":"text","text":"2- adama saldır","x":2234,"y":-3430,"width":250,"height":60},
		{"id":"394f5af4b5586d68","type":"text","text":"oyuncu adama saldırır ve kaza geçirirler. oyuncu hayatını kaybeder","x":2232,"y":-3600,"width":250,"height":92},
		{"id":"127edd25b8084e6a","type":"text","text":"yolculuk devam eder ve adam giderek garipleşir. en sonda şehre giden yoldan dağ yoluna sapar.","x":2502,"y":-3600,"width":250,"height":136},
		{"id":"5acda237657682f1","type":"text","text":"oyuncu yine arabadan atlar. arkadan gelen kadın duramaz ve oyuncuyu ezer. ","x":1780,"y":-3600,"width":250,"height":124},
		{"id":"4ab4833ef8a13a6c","type":"text","text":"2- oyuncu kaçmaya çalışır","x":1562,"y":-3110,"width":250,"height":60},
		{"id":"766b88e4fefc6e60","type":"text","text":"allen üzülür ve oyuncuya yemediği için çok üzgün olduğunu belli eder","x":1449,"y":-3883,"width":250,"height":77},
		{"id":"745a412f525a8800","type":"text","text":"1- arabadan atla","x":2370,"y":-3791,"width":250,"height":60},
		{"id":"704295bd02547532","type":"text","text":"3- bekle","x":2717,"y":-3779,"width":250,"height":60},
		{"id":"063e216b1e9bad47","type":"text","text":"2- oyuncu yemek yemez","x":1389,"y":-3617,"width":250,"height":60},
		{"id":"b37bb8013cb149d0","type":"text","text":"kapı kitlidir. adam onu öldürmeye çalıştığını itiraf eder ve oyuncuyu oracıkta silahıyla vurur","x":2247,"y":-4053,"width":250,"height":153},
		{"id":"9a98928e1a69ac54","type":"text","text":"bir dağ kulubesine gelirler. adam oyuncuyu öldürmeye çalıştığını itiraf eder. ","x":2675,"y":-4053,"width":250,"height":128},
		{"id":"41c4606c5f9907f0","type":"text","text":"1- oyuncu allen a üzülüp yemeği yer","x":1301,"y":-4095,"width":250,"height":60},
		{"id":"43311264fb620bbf","type":"text","text":"2- oyuncu yinede yemeği yemez. allen bir anda sinirlenip canavara dönüşür ve oyuncuya saldırır","x":1654,"y":-4220,"width":250,"height":167},
		{"id":"f36bf2ba5f8d0ace","type":"text","text":"3- cos(-x)","x":2438,"y":-4844,"width":250,"height":60},
		{"id":"7c0754fcaad62a72","type":"text","text":"1- kaç","x":2670,"y":-4207,"width":250,"height":60},
		{"id":"7406215d00a23c1a","type":"text","text":"adam oyuncuyu silahla vurur","x":2620,"y":-4461,"width":250,"height":60},
		{"id":"faaaa3f22f851796","type":"text","text":"2- saldır","x":3000,"y":-4302,"width":250,"height":60},
		{"id":"e79071bf196df807","type":"text","text":"oyuncu adamın elinden silahı almaya çalışır.","x":2989,"y":-4461,"width":250,"height":60},
		{"id":"1cae69be4bee20a6","type":"text","text":"sin(x) in türevi nedir","x":2941,"y":-4648,"width":250,"height":60},
		{"id":"12a9ff7ac388ed76","type":"text","text":"1- sin(x)","x":2762,"y":-4828,"width":250,"height":60},
		{"id":"ae0b5d83bb035449","type":"text","text":"4- -cos(x)","x":3300,"y":-4899,"width":250,"height":60},
		{"id":"f09cb3cbfe3d4991","type":"text","text":"2- sin(-x)","x":2977,"y":-4902,"width":250,"height":60},
		{"id":"a9801f03eaedadf3","type":"text","text":"adamın silahını alamaz ve ölür","x":2706,"y":-5302,"width":250,"height":60},
		{"id":"f4ca952e5ec31b18","type":"text","text":"adamın silahını alır ve adamı vurup arabasını alır","x":3555,"y":-5293,"width":250,"height":60},
		{"id":"d2e87ea87c1c2fa5","type":"text","text":"2-oyuncu adama hak verir ve hayatının geri kalanını bu sakin dünyada geçirir","x":802,"y":-4240,"width":250,"height":87},
		{"id":"a540931e2f17eacc","type":"text","text":"5- cos(x)","x":3629,"y":-4900,"width":250,"height":60},
		{"id":"238cff95807501cf","type":"text","text":"karşısına iki yol çıkar","x":1212,"y":-101,"width":250,"height":60},
		{"id":"94454ec4d1257934","type":"text","text":"neler olduğuna anlam veremez ve patikada yürümeye başlar","x":900,"y":60,"width":280,"height":80},
		{"id":"3282f2c4924854a6","type":"text","text":"Oyuncu bilmediği bir ormanda hafızası yitik bir şekilde uyanır.","x":500,"y":174,"width":300,"height":106},
		{"id":"e3a0e0735b232530","type":"text","text":"yemek o kadar lezzetlidirki oyuncu kendinden geçer. bu hayatı sorgulatan yemeği yemeye devam ederken yavaşça bir bataklık canavarına dönüşür. artık hayatının geri kalanını allen ile yaşayacaktır","x":1138,"y":-4600,"width":250,"height":255}
	],
